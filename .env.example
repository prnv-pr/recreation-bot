# Example env file for local testing
# IMPORTANT: in the repo, use GitHub Secrets instead of committing credentials

# Base64-encoded service account JSON for Google Sheets access (use base64 -w0 service-account.json)
GOOGLE_SA_JSON_B64=<base64-encoded-service-account-json>

# Google sheet id (from the sheet URL)
SHEET_ID=<your-sheet-id>

# Recreation.gov credentials
RECGOV_USERNAME=your-email@example.com
RECGOV_PASSWORD=your-password

# Facility timezone and hour (IANA tz name and hour 0-23 local)
FACILITY_TZ=America/Denver
DESIRED_LOCAL_HOUR=15

# Maximum parallel browser contexts/pages (1..15)
MAX_WORKERS=5

# Headless or not for local testing (true/false)
HEADLESS=false

# Optional: set DRY_RUN=true to prepare and not submit
DRY_RUN=true
